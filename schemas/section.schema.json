{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "id_prefix"],
  "properties": {
    "name": {"type": "string", "pattern": "\\S"},
    "id_prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "aliases": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
