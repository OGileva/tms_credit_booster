{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "include"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string", "pattern": "\\S"},
    "include": {"$ref": "#/$defs/rules"},
    "exclude": {"$ref": "#/$defs/rules"}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"},
      "uniqueItems": true
    },
    "rules": {
      "type": "object",
      "properties": {
        "case_ids": {"$ref": "#/$defs/strings"},
        "products": {"$ref": "#/$defs/strings"},
        "sections": {"$ref": "#/$defs/strings"},
        "tags": {"$ref": "#/$defs/strings"},
        "statuses": {
          "type": "array",
          "items": {"enum": ["active", "draft", "deprecated"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
