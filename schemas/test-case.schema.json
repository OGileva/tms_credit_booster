{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TMS CB test case metadata",
  "type": "object",
  "required": ["id", "title", "status", "tags", "tasks"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,5}$"
    },
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "draft", "deprecated"]},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tasks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "criticality": {"enum": ["critical", "medium", "low"]},
    "source": {"type": "string"}
  },
  "additionalProperties": false
}
